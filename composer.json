{
    "name": "hexium-agency/zoombat-scout-elasticsearch-driver",
    "type": "library",
    "description": "Maintained fork of babenkoivan/scout-elasticsearch-driver for Laravel Scout 10 and elasticsearch-php 7.17",
    "keywords": [
        "elastic",
        "elasticsearch",
        "driver",
        "engine",
        "laravel",
        "scout",
        "search"
    ],
    "homepage": "https://github.com/hexium-agency/zoombat-scout-elasticsearch-driver",
    "license": "MIT",
    "authors": [
        {
            "name": "Babenko Ivan",
            "email": "babenko.i.a@gmail.com",
            "role": "Original author"
        }
    ],
    "require": {
        "php": "^8.2",
        "elasticsearch/elasticsearch": "^7.17.3",
        "laravel/scout": "^10.23.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.5",
        "mockery/mockery": "^1.6"
    },
    "replace": {
        "babenkoivan/scout-elasticsearch-driver": "4.3.0"
    },
    "autoload": {
        "psr-4": {
            "ScoutElastic\\Tests\\": "tests/",
            "ScoutElastic\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ScoutElastic\\ScoutElasticServiceProvider"
            ]
        }
    }
}
